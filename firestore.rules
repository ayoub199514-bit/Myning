rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.demoBalance == 0;
      // Clients may only change displayName. Balances and IDs are server-controlled.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow delete: if isAdmin();
    }

    match /balanceAudit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /depositRequests/{requestId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}